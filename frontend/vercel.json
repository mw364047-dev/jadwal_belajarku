{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://jadwalbelajarku-production.up.railway.app/api/:path*"
    },
    {
      "source": "/sanctum/:path*",
      "destination": "https://jadwalbelajarku-production.up.railway.app/sanctum/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/sanctum/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, no-cache, must-revalidate"
        }
      ]
    }
  ]
}